---
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>hauke@dev: ~/portfolio</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet" />
		<style>
			* {
				font-family: 'JetBrains Mono', monospace;
			}

			:root {
				--bg: #0a0a0a;
				--green: #00ff41;
				--green-mid: #00cc33;
				--green-dim: #1a6b2a;
				--green-border: #1a3a1a;
				--glow: 0 0 10px rgba(0, 255, 65, 0.4), 0 0 20px rgba(0, 255, 65, 0.15);
				--glow-strong: 0 0 10px rgba(0, 255, 65, 0.6), 0 0 30px rgba(0, 255, 65, 0.3), 0 0 60px rgba(0, 255, 65, 0.1);
			}

			body {
				background: var(--bg);
				color: var(--green);
				margin: 0;
				padding: 0;
				overflow-x: hidden;
				-webkit-font-smoothing: none;
				-moz-osx-font-smoothing: unset;
			}

			/* CRT Scanlines */
			.scanlines::after {
				content: "";
				position: fixed;
				inset: 0;
				background: repeating-linear-gradient(
					0deg,
					transparent,
					transparent 1px,
					rgba(0, 0, 0, 0.15) 1px,
					rgba(0, 0, 0, 0.15) 2px
				);
				pointer-events: none;
				z-index: 1000;
			}

			/* Screen flicker */
			@keyframes flicker {
				0% { opacity: 1; }
				3% { opacity: 0.97; }
				6% { opacity: 1; }
				7.5% { opacity: 0.95; }
				9% { opacity: 1; }
				50% { opacity: 1; }
				52% { opacity: 0.98; }
				54% { opacity: 1; }
				75% { opacity: 1; }
				77% { opacity: 0.96; }
				78% { opacity: 1; }
			}

			.terminal-screen {
				animation: flicker 8s infinite;
			}

			/* Blinking cursor */
			@keyframes blink {
				0%, 49% { opacity: 1; }
				50%, 100% { opacity: 0; }
			}

			.cursor-blink {
				animation: blink 1s step-end infinite;
				color: var(--green);
				text-shadow: var(--glow);
			}

			/* Typing effect */
			@keyframes typing {
				from { width: 0; }
				to { width: 100%; }
			}

			@keyframes fadeInLine {
				from { opacity: 0; }
				to { opacity: 1; }
			}

			.boot-line {
				opacity: 0;
				animation: fadeInLine 0.05s ease-out forwards;
			}
			.boot-line:nth-child(1) { animation-delay: 0.2s; }
			.boot-line:nth-child(2) { animation-delay: 0.5s; }
			.boot-line:nth-child(3) { animation-delay: 0.9s; }
			.boot-line:nth-child(4) { animation-delay: 1.4s; }
			.boot-line:nth-child(5) { animation-delay: 1.8s; }
			.boot-line:nth-child(6) { animation-delay: 2.0s; }
			.boot-line:nth-child(7) { animation-delay: 2.2s; }
			.boot-line:nth-child(8) { animation-delay: 2.4s; }
			.boot-line:nth-child(9) { animation-delay: 2.7s; }
			.boot-line:nth-child(10) { animation-delay: 2.9s; }
			.boot-line:nth-child(11) { animation-delay: 3.1s; }
			.boot-line:nth-child(12) { animation-delay: 3.3s; }

			/* Section fade-in on scroll */
			.section-reveal {
				opacity: 0;
				transform: translateY(8px);
				transition: opacity 0.6s ease, transform 0.6s ease;
			}
			.section-reveal.visible {
				opacity: 1;
				transform: translateY(0);
			}

			/* Title bar dots */
			.dot {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				display: inline-block;
			}

			/* Prompt styling */
			.prompt {
				color: var(--green-mid);
				white-space: nowrap;
			}
			.prompt-user {
				color: var(--green);
			}
			.prompt-path {
				color: #00cc99;
			}

			/* Command output styling */
			.cmd {
				color: var(--green);
				text-shadow: 0 0 6px rgba(0, 255, 65, 0.25);
			}

			.output {
				color: var(--green-mid);
			}

			.dim {
				color: var(--green-dim);
			}

			/* Section divider */
			.divider {
				border: none;
				border-top: 1px dashed var(--green-border);
				margin: 2.5rem 0;
			}

			/* Glow heading */
			.glow-text {
				text-shadow: var(--glow-strong);
			}

			/* Links */
			a.terminal-link {
				color: var(--green);
				text-decoration: none;
				border-bottom: 1px solid var(--green-border);
				transition: border-color 0.2s, text-shadow 0.2s;
			}
			a.terminal-link:hover {
				border-color: var(--green);
				text-shadow: var(--glow);
			}

			/* Photo placeholders */
			.photo-placeholder {
				border: 1px solid var(--green-border);
				background: rgba(0, 255, 65, 0.02);
				display: flex;
				align-items: center;
				justify-content: center;
				position: relative;
				overflow: hidden;
			}
			.photo-placeholder::before {
				content: "";
				position: absolute;
				inset: 4px;
				border: 1px dashed var(--green-border);
			}

			/* Project entry hover */
			.project-entry {
				padding: 1rem 0.75rem;
				margin: 0 -0.75rem;
				border-radius: 4px;
				transition: background 0.2s;
			}
			.project-entry:hover {
				background: rgba(0, 255, 65, 0.03);
			}

			/* Blog entry hover */
			.blog-entry {
				padding: 1rem 0.75rem;
				margin: 0 -0.75rem;
				border-radius: 4px;
				transition: background 0.2s;
				border-left: 2px solid transparent;
			}
			.blog-entry:hover {
				background: rgba(0, 255, 65, 0.03);
				border-left-color: var(--green-dim);
			}

			/* Work entry */
			.work-entry {
				padding-left: 1rem;
				border-left: 2px solid var(--green-border);
			}

			/* Contact input effect */
			@keyframes inputBlink {
				0%, 49% { border-right-color: var(--green); }
				50%, 100% { border-right-color: transparent; }
			}
			.input-prompt {
				border-right: 2px solid var(--green);
				animation: inputBlink 1s step-end infinite;
				padding-right: 4px;
			}

			/* Title bar */
			.title-bar {
				background: #111;
				border-bottom: 1px solid var(--green-border);
				border-radius: 10px 10px 0 0;
				padding: 0.75rem 1rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				position: sticky;
				top: 0;
				z-index: 100;
			}

			/* CRT vignette */
			.vignette::before {
				content: "";
				position: fixed;
				inset: 0;
				background: radial-gradient(
					ellipse at center,
					transparent 60%,
					rgba(0, 0, 0, 0.6) 100%
				);
				pointer-events: none;
				z-index: 999;
			}

			/* Scrollbar */
			::-webkit-scrollbar {
				width: 8px;
			}
			::-webkit-scrollbar-track {
				background: var(--bg);
			}
			::-webkit-scrollbar-thumb {
				background: var(--green-border);
				border-radius: 4px;
			}
			::-webkit-scrollbar-thumb:hover {
				background: var(--green-dim);
			}

			/* Value list checkmarks */
			.value-item::before {
				content: "✓";
				color: var(--green);
				margin-right: 0.75rem;
				text-shadow: var(--glow);
			}

			/* Tech tree connector */
			.tree-branch {
				color: var(--green-dim);
			}
		</style>
