					<div style="display: flex; flex-wrap: wrap; gap: 10px;">
						<span class="sticker" style="background: var(--green);">Node.js</span>
						<span class="sticker" style="background: var(--yellow);">Bun</span>
						<span class="sticker" style="background: var(--blue);">tRPC</span>
						<span class="sticker" style="background: var(--red); color: #fff;">Drizzle ORM</span>
						<span class="sticker" style="background: var(--yellow);">Symfony</span>
