				<div>
					<h3 style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px; font-family: 'Fira Code', monospace;">Other</h3>
					<div style="display: flex; flex-wrap: wrap; gap: 10px;">
						<span class="sticker" style="background: var(--red); color: #fff;">Astro</span>
						<span class="sticker" style="background: var(--yellow);">Jujutsu VCS</span>
						<span class="sticker" style="background: var(--green);">Git</span>
