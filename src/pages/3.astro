					<div style="display: flex; flex-wrap: wrap; gap: 10px;">
						<span class="sticker" style="background: var(--yellow);">Zod</span>
						<span class="sticker" style="background: var(--green);">Effect TS</span>
						<span class="sticker" style="background: var(--blue);">tRPC</span>
					</div>
