						<span class="sticker" style="background: var(--blue);">Go</span>
						<span class="sticker" style="background: var(--red); color: #fff;">PHP</span>
						<span class="sticker" style="background: var(--green);">Python</span>
						<span class="sticker" style="background: var(--yellow);">Java</span>
					</div>
				</div>

				<!-- Frontend -->
				<div>
