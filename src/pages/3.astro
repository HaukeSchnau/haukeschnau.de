			</div>
		</section>

		<!-- CORE VALUES -->
		<section class="container" style="padding-top: 40px; padding-bottom: 40px;">
			<h2 class="reveal" style="font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 32px; transform: rotate(-1deg);">What I Believe</h2>

			<div class="reveal grid-values" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
