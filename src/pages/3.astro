---
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>HAUKE SCHNAU — Software Developer</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Fira+Code:wght@400;500;600&family=Karla:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
		<style>
			:root {
				--bg: #FFFDF7;
				--text: #1a1a1a;
				--border: #1a1a1a;
				--yellow: #FFD60A;
				--red: #FF5252;
				--green: #4ADE80;
				--blue: #60A5FA;
				--shadow: 8px 8px 0px #1a1a1a;
				--shadow-sm: 4px 4px 0px #1a1a1a;
				--shadow-hover: 12px 12px 0px #1a1a1a;
				--border-w: 3px;
				--radius: 4px;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				font-family: 'Karla', sans-serif;
				background: var(--bg);
				color: var(--text);
				background-image: radial-gradient(circle, #e0ddd6 1px, transparent 1px);
				background-size: 24px 24px;
				overflow-x: hidden;
			}

			h1, h2, h3, h4 {
				font-family: 'Archivo Black', sans-serif;
				text-transform: uppercase;
				letter-spacing: -0.02em;
			}

			code, .mono {
				font-family: 'Fira Code', monospace;
			}

			.container {
				max-width: 1400px;
				margin: 0 auto;
				padding: 0 24px;
			}

			.card {
				border: var(--border-w) solid var(--border);
				box-shadow: var(--shadow);
				border-radius: var(--radius);
				padding: 32px;
				transition: transform 150ms ease, box-shadow 150ms ease;
			}

			.card:hover {
				transform: translate(-2px, -2px);
				box-shadow: var(--shadow-hover);
			}

			.sticker {
				display: inline-block;
				border: var(--border-w) solid var(--border);
				border-radius: 999px;
				padding: 6px 16px;
				font-family: 'Karla', sans-serif;
				font-weight: 700;
				font-size: 0.85rem;
				box-shadow: var(--shadow-sm);
				transition: transform 150ms ease, box-shadow 150ms ease;
			}

			.sticker:hover {
				transform: translate(-1px, -1px);
				box-shadow: 6px 6px 0px #1a1a1a;
			}

			.btn {
				display: inline-block;
				border: var(--border-w) solid var(--border);
				border-radius: var(--radius);
				padding: 14px 28px;
				font-family: 'Archivo Black', sans-serif;
				font-size: 1rem;
				text-transform: uppercase;
				text-decoration: none;
				color: var(--text);
				background: var(--yellow);
				box-shadow: var(--shadow);
				cursor: pointer;
				transition: transform 150ms ease, box-shadow 150ms ease;
			}

			.btn:hover {
				transform: translate(-3px, -3px);
				box-shadow: var(--shadow-hover);
			}

			.btn:active {
				transform: translate(4px, 4px);
				box-shadow: none;
			}

			/* Marquee */
			.marquee-track {
				display: flex;
				width: max-content;
				animation: marquee 25s linear infinite;
			}

			@keyframes marquee {
				0% { transform: translateX(0); }
				100% { transform: translateX(-50%); }
			}

			.marquee-track:hover {
				animation-play-state: paused;
			}

			/* Reveal animation */
			.reveal {
				opacity: 0;
				transform: translateY(30px);
				transition: opacity 0.6s ease, transform 0.6s ease;
			}

			.reveal.visible {
				opacity: 1;
				transform: translateY(0);
			}

			/* Timeline */
			.timeline {
				position: relative;
				padding-left: 40px;
			}

			.timeline::before {
				content: '';
				position: absolute;
				left: 14px;
				top: 0;
				bottom: 0;
				width: 4px;
				background: var(--text);
				border-radius: 2px;
			}

			.timeline-item {
				position: relative;
				margin-bottom: 40px;
			}

			.timeline-item::before {
				content: '';
				position: absolute;
				left: -34px;
				top: 18px;
				width: 20px;
				height: 20px;
				background: var(--yellow);
				border: 3px solid var(--text);
				border-radius: 50%;
				z-index: 1;
			}

			.timeline-item:nth-child(2)::before { background: var(--blue); }
			.timeline-item:nth-child(3)::before { background: var(--green); }
			.timeline-item:nth-child(4)::before { background: var(--red); }

			/* Placeholder images */
			.img-placeholder {
				border: var(--border-w) dashed var(--border);
				background: #f0ede6;
				display: flex;
				align-items: center;
				justify-content: center;
				color: #999;
				font-family: 'Fira Code', monospace;
				font-size: 0.85rem;
			}

			/* Responsive */
			@media (max-width: 768px) {
				.hero-name {
					font-size: clamp(3rem, 12vw, 5rem) !important;
				}
				.grid-2 { grid-template-columns: 1fr !important; }
				.grid-3 { grid-template-columns: 1fr !important; }
				.grid-values { grid-template-columns: 1fr !important; }
				.card { padding: 20px; }
				.container { padding: 0 16px; }
			}

			@media (max-width: 480px) {
				.hero-name {
					font-size: clamp(2.2rem, 14vw, 3.5rem) !important;
				}
			}
		</style>
	</head>
	<body>

		<!-- Back Link -->
		<nav class="container" style="padding-top: 20px;">
			<a href="/" class="sticker" style="background: var(--yellow); text-decoration: none; color: var(--text); transform: rotate(-2deg); display: inline-block;">
