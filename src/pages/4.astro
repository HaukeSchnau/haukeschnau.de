---
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>HS-2026-001 — Hauke Schnau, Software Engineer</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Sans+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<style>
			:root {
				--bp-bg: #0d1b2a;
				--bp-grid: #1b2d44;
				--bp-grid-bold: #243b55;
				--bp-text: #e0e6ed;
				--bp-text-dim: #7b8fa3;
				--bp-cyan: #4fc3f7;
				--bp-white: #ffffff;
				--bp-orange: #f4845f;
				--bp-grid-size: 20px;
			}

			* { box-sizing: border-box; margin: 0; padding: 0; }

			body {
				font-family: 'IBM Plex Mono', monospace;
				background-color: var(--bp-bg);
				color: var(--bp-text);
				overflow-x: hidden;
				font-size: 13px;
				line-height: 1.6;
			}

			.bp-grid-bg {
				background-image:
					repeating-linear-gradient(0deg, var(--bp-grid) 0 1px, transparent 1px var(--bp-grid-size)),
					repeating-linear-gradient(90deg, var(--bp-grid) 0 1px, transparent 1px var(--bp-grid-size)),
					repeating-linear-gradient(0deg, var(--bp-grid-bold) 0 1px, transparent 1px 100px),
					repeating-linear-gradient(90deg, var(--bp-grid-bold) 0 1px, transparent 1px 100px);
				background-size:
					var(--bp-grid-size) var(--bp-grid-size),
					var(--bp-grid-size) var(--bp-grid-size),
					100px 100px,
					100px 100px;
			}

			/* Outer frame */
			.bp-frame {
				border: 2px solid var(--bp-cyan);
				outline: 1px solid var(--bp-cyan);
				outline-offset: 4px;
				position: relative;
			}

			/* Corner registration marks */
			.bp-frame::before,
			.bp-frame::after {
				content: "";
				position: absolute;
				width: 24px;
				height: 24px;
				border-color: var(--bp-cyan);
				border-style: solid;
				z-index: 10;
			}
			.bp-frame::before {
				top: -10px;
				left: -10px;
				border-width: 2px 0 0 2px;
			}
			.bp-frame::after {
				top: -10px;
				right: -10px;
				border-width: 2px 2px 0 0;
			}

			.corner-bl, .corner-br {
				position: absolute;
				width: 24px;
				height: 24px;
				border-color: var(--bp-cyan);
				border-style: solid;
				z-index: 10;
				pointer-events: none;
			}
			.corner-bl {
				bottom: -10px;
				left: -10px;
				border-width: 0 0 2px 2px;
			}
			.corner-br {
				bottom: -10px;
				right: -10px;
				border-width: 0 2px 2px 0;
			}

			/* Section callout number */
			.callout-num {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 28px;
				height: 28px;
				border: 1.5px solid var(--bp-cyan);
				border-radius: 50%;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-weight: 600;
				font-size: 13px;
				color: var(--bp-cyan);
				flex-shrink: 0;
			}

			/* Section heading */
			.section-heading {
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--bp-white);
				font-size: 16px;
			}

			/* Annotation pointer line */
			.annotation-line {
				position: relative;
				padding-left: 20px;
				border-left: 1px solid var(--bp-cyan);
			}
			.annotation-line::before {
				content: "";
				position: absolute;
				left: -4px;
				top: 0;
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--bp-cyan);
			}

			/* Crosshair marks */
			.crosshair {
				position: relative;
			}
			.crosshair::before,
			.crosshair::after {
				content: "+";
				position: absolute;
				color: var(--bp-cyan);
				font-size: 14px;
				opacity: 0.4;
				line-height: 1;
				pointer-events: none;
			}
			.crosshair::before { top: -4px; left: -4px; }
			.crosshair::after { bottom: -4px; right: -4px; }

			/* Dimension line */
			.dim-line {
				position: relative;
				display: flex;
				align-items: center;
				gap: 6px;
				color: var(--bp-orange);
				font-size: 10px;
				letter-spacing: 0.05em;
			}
			.dim-line::before,
			.dim-line::after {
				content: "";
				flex: 1;
				height: 1px;
				background: var(--bp-orange);
				opacity: 0.6;
			}

			/* Tech stack box */
			.tech-box {
				border: 1px solid var(--bp-cyan);
				padding: 8px 12px;
				font-size: 11px;
				color: var(--bp-text);
				position: relative;
				background: rgba(13, 27, 42, 0.85);
			}
			.tech-box-label {
				position: absolute;
				top: -8px;
				left: 8px;
				background: var(--bp-bg);
				padding: 0 6px;
				font-size: 9px;
				color: var(--bp-orange);
				letter-spacing: 0.1em;
				text-transform: uppercase;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
			}
			.tech-box-center {
				border: 2px solid var(--bp-white);
				padding: 12px 20px;
				text-align: center;
				font-weight: 600;
				color: var(--bp-white);
				font-size: 14px;
				background: rgba(13, 27, 42, 0.9);
				position: relative;
			}

			/* Connection line vertical */
			.conn-v {
				width: 1px;
				background: var(--bp-cyan);
				margin: 0 auto;
				position: relative;
			}
			.conn-v::after {
				content: "";
				position: absolute;
				bottom: -3px;
				left: -3px;
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--bp-cyan);
			}

			/* Spec table */
			.spec-table {
				width: 100%;
				border-collapse: collapse;
				font-size: 12px;
			}
			.spec-table th,
			.spec-table td {
				border: 1px solid var(--bp-grid-bold);
				padding: 8px 12px;
				text-align: left;
			}
			.spec-table th {
				background: rgba(79, 195, 247, 0.08);
				color: var(--bp-cyan);
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				font-size: 11px;
			}
			.spec-table td:first-child {
				color: var(--bp-orange);
				font-weight: 500;
				white-space: nowrap;
			}

			/* Revision table */
			.rev-table {
				width: 100%;
				border-collapse: collapse;
				font-size: 12px;
			}
			.rev-table th,
			.rev-table td {
				border: 1px solid var(--bp-grid-bold);
				padding: 10px 12px;
				text-align: left;
				vertical-align: top;
			}
			.rev-table th {
				background: rgba(79, 195, 247, 0.08);
				color: var(--bp-cyan);
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				font-size: 11px;
			}

			/* Detail view card */
			.detail-card {
				border: 1px solid var(--bp-grid-bold);
				position: relative;
				background: rgba(13, 27, 42, 0.5);
			}
			.detail-card-header {
				border-bottom: 1px solid var(--bp-grid-bold);
				padding: 12px 16px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 12px;
				flex-wrap: wrap;
			}
			.detail-card-body {
				padding: 16px;
			}

			.status-active {
				color: #66bb6a;
				border: 1px solid #66bb6a;
				padding: 2px 8px;
				font-size: 10px;
				letter-spacing: 0.1em;
			}
			.status-archived {
				color: var(--bp-text-dim);
				border: 1px solid var(--bp-grid-bold);
				padding: 2px 8px;
				font-size: 10px;
				letter-spacing: 0.1em;
			}

			/* Photo placeholder */
			.fig-placeholder {
				border: 1px dashed var(--bp-cyan);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--bp-text-dim);
				font-size: 11px;
				position: relative;
				background: rgba(79, 195, 247, 0.02);
			}
			.fig-placeholder .fig-label {
				position: absolute;
				bottom: -20px;
				left: 0;
				font-size: 10px;
				color: var(--bp-orange);
			}
			.fig-placeholder .fig-dim-top {
				position: absolute;
				top: -18px;
				left: 50%;
				transform: translateX(-50%);
				font-size: 9px;
				color: var(--bp-orange);
			}
			.fig-placeholder .fig-dim-side {
				position: absolute;
				right: -40px;
				top: 50%;
				transform: translateY(-50%) rotate(90deg);
				font-size: 9px;
				color: var(--bp-orange);
			}

			/* Title block (bottom-right style) */
			.title-block {
				border: 2px solid var(--bp-cyan);
			}
			.title-block-row {
				display: flex;
				border-bottom: 1px solid var(--bp-grid-bold);
			}
			.title-block-row:last-child {
				border-bottom: none;
			}
			.title-block-label {
				width: 120px;
				flex-shrink: 0;
				padding: 6px 10px;
				border-right: 1px solid var(--bp-grid-bold);
				color: var(--bp-text-dim);
				font-size: 10px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.title-block-value {
				flex: 1;
				padding: 6px 10px;
				color: var(--bp-white);
				font-size: 11px;
			}

			.draw-in {
				opacity: 0;
				transform: translateY(14px);
				transition: opacity 0.6s ease-out, transform 0.6s ease-out;
			}
			.draw-in.is-visible {
				opacity: 1;
				transform: translateY(0);
			}

			/* Scrollable table wrapper */
			.table-scroll {
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
			}
			.table-scroll::-webkit-scrollbar {
				height: 4px;
			}
			.table-scroll::-webkit-scrollbar-track {
				background: var(--bp-bg);
			}
			.table-scroll::-webkit-scrollbar-thumb {
				background: var(--bp-grid-bold);
			}

			/* Back link */
			.back-link {
				color: var(--bp-text-dim);
				text-decoration: none;
				font-size: 11px;
				letter-spacing: 0.1em;
				transition: color 0.2s;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
			}
			.back-link:hover {
				color: var(--bp-cyan);
			}

			a {
				color: var(--bp-cyan);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}

			/* Responsive */
			@media (max-width: 768px) {
				:root { --bp-grid-size: 16px; }
				body { font-size: 12px; }
				.section-heading { font-size: 14px; }
				.title-block-label { width: 90px; font-size: 9px; }
				.title-block-value { font-size: 10px; }
				.tech-box { font-size: 10px; padding: 6px 8px; }
			}
		</style>
	</head>
	<body class="bp-grid-bg">

		<!-- Nav -->
		<nav class="draw-in" style="padding: 16px 24px; display: flex; justify-content: space-between; align-items: center;">
			<a href="/" class="back-link">REV ← SHEET INDEX</a>
			<span style="font-size: 10px; color: var(--bp-text-dim); letter-spacing: 0.1em;">HS-2026-001 · SHEET 4 OF 5</span>
		</nav>

		<!-- Main Blueprint Sheet -->
		<main style="max-width: 1300px; margin: 0 auto; padding: 8px 20px 60px;">
			<div class="bp-frame" style="padding: 32px 28px; position: relative;">
				<div class="corner-bl"></div>
				<div class="corner-br"></div>

				<!-- ╔═══════════════════════════════════╗ -->
				<!-- ║  1. TITLE BLOCK / BLUEPRINT HEADER ║ -->
				<!-- ╚═══════════════════════════════════╝ -->
				<section class="draw-in delay-1" style="margin-bottom: 48px;">
					<div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
						<span class="callout-num">1</span>
						<span class="section-heading">Title Block</span>
						<span style="flex: 1; height: 1px; background: var(--bp-grid-bold);"></span>
					</div>

					<div class="title-block">
						<div class="title-block-row">
							<div class="title-block-label">Sheet Title</div>
							<div class="title-block-value" style="font-family: 'IBM Plex Sans Condensed', sans-serif; font-size: 16px; font-weight: 700; letter-spacing: 0.06em;">HAUKE SCHNAU — SOFTWARE ENGINEER</div>
						</div>
						<div style="display: flex; flex-wrap: wrap;">
							<div style="flex: 1; min-width: 200px;">
								<div class="title-block-row">
									<div class="title-block-label">Drawing No.</div>
									<div class="title-block-value">HS-2026-001</div>
								</div>
								<div class="title-block-row">
									<div class="title-block-label">Scale</div>
									<div class="title-block-value">1:1</div>
								</div>
							</div>
							<div style="flex: 1; min-width: 200px;">
								<div class="title-block-row">
									<div class="title-block-label">Date</div>
									<div class="title-block-value">MARCH 2026</div>
								</div>
								<div class="title-block-row">
									<div class="title-block-label">Rev</div>
									<div class="title-block-value">3.0 <span style="color: var(--bp-text-dim);">(BACHELOR COMPLETE)</span></div>
								</div>
							</div>
							<div style="flex: 1; min-width: 200px;">
								<div class="title-block-row">
									<div class="title-block-label">Location</div>
									<div class="title-block-value">HAMBURG / BREMEN, GERMANY</div>
								</div>
								<div class="title-block-row">
									<div class="title-block-label">Status</div>
									<div class="title-block-value" style="color: #66bb6a;">AVAILABLE</div>
								</div>
							</div>
						</div>
					</div>

					<!-- General Notes -->
					<div style="margin-top: 20px; border: 1px solid var(--bp-grid-bold); padding: 16px;">
						<div style="font-family: 'IBM Plex Sans Condensed', sans-serif; font-size: 11px; color: var(--bp-orange); letter-spacing: 0.1em; margin-bottom: 8px; text-transform: uppercase;">General Notes</div>
						<p style="color: var(--bp-text); max-width: 800px;">
							Full-stack TypeScript engineer with 3+ years production experience. Building type-safe, AI-native software.
							B.Sc. Computer Science, Universität Hamburg (GPA: 1.47).
						</p>
					</div>
				</section>

				<!-- ╔═══════════════════════════════════════╗ -->
				<!-- ║  2. SYSTEM ARCHITECTURE (TECH STACK)   ║ -->
				<!-- ╚═══════════════════════════════════════╝ -->
				<section class="draw-in delay-2" style="margin-bottom: 48px;">
					<div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
						<span class="callout-num">2</span>
						<span class="section-heading">System Architecture Diagram</span>
						<span style="flex: 1; height: 1px; background: var(--bp-grid-bold);"></span>
					</div>

					<div class="dim-line" style="margin-bottom: 20px;">
						<span>TECHNOLOGY LAYER MAP</span>
					</div>

					<!-- Central node -->
					<div style="text-align: center; margin-bottom: 4px;">
						<div class="tech-box-center" style="display: inline-block; min-width: 180px;">
							HAUKE.DEV
						</div>
					</div>
					<div class="conn-v" style="height: 24px;"></div>

					<!-- Input Layer -->
					<div style="margin-bottom: 4px;">
						<div class="tech-box crosshair" style="position: relative;">
							<span class="tech-box-label">Languages</span>
							<div style="display: flex; flex-wrap: wrap; gap: 8px; padding-top: 4px;">
								<span>TypeScript</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Go</span><span style="color: var(--bp-text-dim);">·</span>
								<span>PHP</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Python</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Java</span>
							</div>
						</div>
					</div>
					<div class="conn-v" style="height: 16px;"></div>

					<!-- Frontend + Backend side by side -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 4px;">
						<div class="tech-box">
							<span class="tech-box-label">Frontend Module</span>
							<div style="display: flex; flex-wrap: wrap; gap: 6px; padding-top: 4px; font-size: 11px;">
								<span>React</span><span style="color: var(--bp-text-dim);">·</span>
								<span>React Native</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Next.js</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Expo</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Tailwind CSS</span><span style="color: var(--bp-text-dim);">·</span>
								<span>shadcn/ui</span>
							</div>
						</div>
						<div class="tech-box">
							<span class="tech-box-label">Backend Module</span>
							<div style="display: flex; flex-wrap: wrap; gap: 6px; padding-top: 4px; font-size: 11px;">
								<span>Node.js</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Bun</span><span style="color: var(--bp-text-dim);">·</span>
								<span>tRPC</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Drizzle ORM</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Symfony</span>
							</div>
						</div>
					</div>

					<!-- Type Safety spanning both -->
					<div style="position: relative; margin-bottom: 4px;">
						<div class="conn-v" style="height: 16px;"></div>
						<div class="tech-box" style="border-color: var(--bp-orange);">
							<span class="tech-box-label" style="color: var(--bp-white); background: var(--bp-bg);">Type Safety Layer ↔ spans FE + BE</span>
							<div style="display: flex; flex-wrap: wrap; gap: 8px; padding-top: 4px;">
								<span>Zod</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Effect TS</span><span style="color: var(--bp-text-dim);">·</span>
								<span>tRPC</span>
							</div>
						</div>
					</div>
					<div class="conn-v" style="height: 16px;"></div>

					<!-- Build + Test side by side -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 4px;">
						<div class="tech-box">
							<span class="tech-box-label">Build Pipeline</span>
							<div style="display: flex; flex-wrap: wrap; gap: 6px; padding-top: 4px; font-size: 11px;">
								<span>Vite</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Turborepo</span><span style="color: var(--bp-text-dim);">·</span>
								<span>OXC Toolchain</span>
							</div>
						</div>
						<div class="tech-box">
							<span class="tech-box-label">Test Suite</span>
							<div style="display: flex; flex-wrap: wrap; gap: 6px; padding-top: 4px; font-size: 11px;">
								<span>Vitest</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Playwright</span>
							</div>
						</div>
					</div>
					<div class="conn-v" style="height: 16px;"></div>

					<!-- Infra + AI + VCS -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
						<div class="tech-box">
							<span class="tech-box-label">Infrastructure</span>
							<div style="display: flex; flex-wrap: wrap; gap: 6px; padding-top: 4px; font-size: 11px;">
								<span>Docker</span><span style="color: var(--bp-text-dim);">·</span>
								<span>NixOS</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Nix Darwin</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Linux</span>
							</div>
						</div>
						<div class="tech-box">
							<span class="tech-box-label">AI Augmentation</span>
							<div style="display: flex; flex-wrap: wrap; gap: 6px; padding-top: 4px; font-size: 11px;">
								<span>Codex</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Cursor</span><span style="color: var(--bp-text-dim);">·</span>
								<span>Claude</span>
							</div>
						</div>
						<div class="tech-box">
